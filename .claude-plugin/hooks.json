{
  "description": "Message board: inject the resolved brief at session start, record ground truth at session end.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/plugin/hooks/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/plugin/hooks/session_end.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
